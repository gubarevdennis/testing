{
  "name": "corporate-knowledge-base",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @kb/shared && npm run build -w @kb/server && npm run build -w @kb/web",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -b packages/shared && tsc -p apps/server --noEmit && tsc -p apps/web --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:resilience": "vitest run --project resilience",
    "test:e2e": "npm run build -w @kb/web -- --outDir ../../.e2e-web --emptyOutDir && playwright test",
    "db:migrate": "node --import tsx --conditions=development apps/server/src/cli.ts migrate up",
    "db:rollback": "node --import tsx --conditions=development apps/server/src/cli.ts migrate down",
    "db:seed": "node --import tsx --conditions=development apps/server/src/cli.ts seed",
    "backup": "bash scripts/backup/backup.sh",
    "restore:verify": "bash scripts/backup/verify-backup.sh",
    "audit-verify": "node --import tsx --conditions=development apps/server/src/cli.ts audit-verify",
    "start": "node apps/server/dist/main.js",
    "requirements:trace": "python3 scripts/requirements/trace.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-security": "^4.2.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7",
    "ws": "^8.22.0"
  },
  "overrides": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7"
  }
}
