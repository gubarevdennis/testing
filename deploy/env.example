# Knowledge base — environment configuration (copy to deploy/.env, chmod 600, never commit the copy).
# Values below are placeholders. Generate secrets with:  openssl rand -base64 48
# Every variable read by apps/server/src/config.ts is listed; defaults are shown in comments.

# ---------------------------------------------------------------- runtime
# production | development | test. production enforces SECRET_KEY, secure cookies
NODE_ENV=production
# HTTP port inside the container
PORT=8080
HOST=0.0.0.0
# external URL (links in exports, OIDC redirect default)
PUBLIC_URL=https://kb.example.corp
# fatal|error|warn|info|debug|trace|silent — JSON logs on stdout
LOG_LEVEL=info
# Liveness/readiness: GET /healthz, GET /readyz. Metrics: GET /metrics (Prometheus).
# if set, /metrics requires "Authorization: Bearer <token>"
METRICS_TOKEN=
# OpenTelemetry traces (OTLP/HTTP JSON), e.g. http://otel-collector:4318; empty = trace ids in logs only
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=kb
# optional auth for the collector: key=value pairs, comma-separated
OTEL_EXPORTER_OTLP_HEADERS=

# ---------------------------------------------------------------- secrets
# REQUIRED in production (>= 32 chars); signs tokens. Rotating it logs everyone out.
SECRET_KEY=CHANGE_ME_min_32_chars_random

# ---------------------------------------------------------------- PostgreSQL 16
# Application role: owner of the schema (migrations run at start under an advisory lock).
DATABASE_URL=postgres://kb:CHANGE_ME@postgres:5432/kb
# connections per instance; keep instances*pool < max_connections - 20
DB_POOL_SIZE=20
# used by deploy/docker-compose.yml to initialise the bundled postgres
POSTGRES_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------- object storage
# data dir: objects (fs driver), tessdata cache, temp files
KB_DATA_DIR=/var/lib/kb
# fs | s3
STORAGE_DRIVER=fs
# fs driver: content-addressed objects (blobs/aa/bb/<sha256>)
STORAGE_ROOT=/var/lib/kb/objects
# s3 driver (MinIO, Ceph RGW, AWS). Enable bucket versioning + object lock for ransomware protection.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=kb-objects
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true
# only for the optional bundled minio service
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------- web UI
# built SPA served by the server (set by the image)
WEB_DIST=/app/apps/web/dist

# ---------------------------------------------------------------- sessions & auth
# 14 days
SESSION_TTL_HOURS=336
# sign out after this many hours without any request (ASVS V3.3.2); 0 disables
SESSION_IDLE_HOURS=12
# default true in production; requires HTTPS in front (deploy/nginx.conf)
COOKIE_SECURE=true
# per client, all API routes
RATE_LIMIT_PER_MINUTE=600
# login / setup endpoints
AUTH_RATE_LIMIT_PER_MINUTE=30
# reverse proxies in front of the app (nginx = 1). Rate limits and audit IPs use the address the nearest trusted
# proxy saw; 'false' when the app is exposed directly. Never 'true' (the client could choose its own address).
TRUST_PROXY=1
# SSO (OpenID Connect) — leave OIDC_ISSUER empty to disable
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# default ${PUBLIC_URL}/api/v1/auth/oidc/callback
OIDC_REDIRECT_URI=

# ---------------------------------------------------------------- limits
# keep nginx client_max_body_size >= this
MAX_UPLOAD_MB=512
MAX_IMPORT_MB=1024

# ---------------------------------------------------------------- background jobs, OCR, export
# set false on instances that must only serve HTTP/WebSocket
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
# tesseract.js (wasm), rus+eng data shipped in the image, works offline
OCR_ENABLED=true
TESSDATA_DIR=/var/lib/kb/tessdata
# PDF export; e.g. /usr/bin/chromium (image built with INSTALL_CHROMIUM=1)
CHROMIUM_PATH=
# host:port of clamd for upload scanning; empty = disabled
CLAMAV_HOST=

# Backup before migration (R-OPS-004): with data present, pending migrations are applied only if a successful
# full backup (scripts/backup/backup.sh, BACKUP_RECORD=1) finished within MIGRATION_BACKUP_MAX_AGE_MIN minutes
# and after the last applied migration. Default: on in production. Override deliberately: cli migrate up --skip-backup-check
MIGRATION_REQUIRE_BACKUP=true
MIGRATION_BACKUP_MAX_AGE_MIN=180
# objects re-hashed per integrity-check batch
INTEGRITY_BATCH=500
# how often live sessions re-check expiring grants
KB_ACL_EXPIRY_CHECK_MS=5000

# ---------------------------------------------------------------- retention (days)
RETENTION_TRASH_DAYS=90
RETENTION_JOURNAL_DAYS=90
RETENTION_REVISION_DAYS=365

# ---------------------------------------------------------------- backups (scripts/backup, backup sidecar)
# Separate credentials for the backup operator (spec: backups protected from a compromised app admin):
# role with SELECT on all tables + INSERT/UPDATE on "backups"; REPLICATION only if BACKUP_PG_BASEBACKUP=1.
BACKUP_DATABASE_URL=postgres://kb_backup:CHANGE_ME@postgres:5432/kb
BACKUP_DIR=/backups
# sidecar: interval between full backups (daily)
BACKUP_SCHEDULE_SECONDS=86400
# sidecar: run verify-backup.sh after every Nth backup (weekly)
BACKUP_VERIFY_EVERY=7
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_WEEKLY=12
BACKUP_KEEP_MONTHLY=12
BACKUP_KEEP_LAST=3
BACKUP_PG_BASEBACKUP=0
# Encryption filter (stdin → stdout). Key material lives in a mounted secret, not in this file.
# e.g. age -R /run/secrets/kb-backup.pub
BACKUP_ENCRYPT_CMD=
# e.g. age -d -i /run/secrets/kb-backup.key   (only where restores run)
BACKUP_DECRYPT_CMD=
# role with CREATEDB for verify-backup.sh's temporary database
VERIFY_ADMIN_URL=

# ---------------------------------------------------------------- offsite copy (docker compose --profile offsite)
# Bucket with Object Lock (COMPLIANCE retention) prepared by the storage administrator; key without delete rights.
OFFSITE_S3_BUCKET=kb-offsite
OFFSITE_S3_ENDPOINT=
OFFSITE_AWS_REGION=us-east-1
OFFSITE_AWS_ACCESS_KEY_ID=CHANGE_ME
OFFSITE_AWS_SECRET_ACCESS_KEY=CHANGE_ME
# seconds between offsite syncs of /backups and the WAL archive
OFFSITE_SYNC_SECONDS=300
# Copying remote images on import through the SSRF-guarded fetcher (internal addresses are always refused,
# except host names listed in REMOTE_FETCH_ALLOW_HOSTS, e.g. an intranet image server)
REMOTE_FETCH_ENABLED=true
REMOTE_FETCH_ALLOW_HOSTS=
REMOTE_FETCH_TIMEOUT_MS=10000
REMOTE_FETCH_MAX_MB=20
