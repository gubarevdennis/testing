# Monthly PITR restore test into a throw-away cluster (verify-pitr.sh), against the offsite copy. Triggered by kb-pitr-verify.timer.
# Runs on the RESTORE/verification host: /etc/kb/restore.env holds BACKUP_DECRYPT_CMD/WAL_DECRYPT_CMD pointing at the private
# key, which is never present on the database or application hosts.
[Unit]
Description=Knowledge base: monthly PITR restore test into a throw-away cluster (verify-pitr.sh), against the offsite copy.
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=postgres
Group=kb
EnvironmentFile=/etc/kb/restore.env
Environment=BACKUP_METRICS_FILE=/var/lib/node_exporter/textfile/kb_backup.prom
ExecStart=/bin/sh -c 'exec /opt/kb/scripts/backup/verify-pitr.sh --repo "${OFFSITE_RESTORE_REPO:-/srv/backups/kb}" --report /var/log/kb/verify-pitr.json'
Nice=10
IOSchedulingClass=idle
ProtectSystem=strict
ReadWritePaths=/srv/backups/kb /var/lib/node_exporter/textfile /tmp /var/log/kb
ReadOnlyPaths=/var/lib/kb
