# add-only, verified copy of backups, object pool and WAL archive to the second medium / offsite (offsite-sync.sh). Triggered by kb-offsite.timer. Settings (BACKUP_DIR, WAL_ARCHIVE_DIR, BACKUP_ENCRYPT_CMD with the PUBLIC key only,
# OFFSITE_TARGET, credentials of the backup-operator role) come from /etc/kb/backup.env — never from this repository.
[Unit]
Description=Knowledge base: add-only, verified copy of backups, object pool and WAL archive to the second medium / offsite (offsite-sync.sh).
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=kb-backup
Group=kb
EnvironmentFile=/etc/kb/backup.env
Environment=BACKUP_METRICS_FILE=/var/lib/node_exporter/textfile/kb_backup.prom
ExecStart=/opt/kb/scripts/backup/offsite-sync.sh
Nice=10
IOSchedulingClass=idle
ProtectSystem=strict
ReadWritePaths=/srv/backups/kb /var/lib/node_exporter/textfile /tmp 
ReadOnlyPaths=/var/lib/kb
