# copy of new files into the backup object pool every 2 minutes (backup.sh --objects-only; file RPO). Triggered by kb-objects-sync.timer. Settings (BACKUP_DIR, WAL_ARCHIVE_DIR, BACKUP_ENCRYPT_CMD with the PUBLIC key only,
# OFFSITE_TARGET, credentials of the backup-operator role) come from /etc/kb/backup.env — never from this repository.
[Unit]
Description=Knowledge base: copy of new files into the backup object pool every 2 minutes (backup.sh --objects-only; file RPO).
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=kb-backup
Group=kb
EnvironmentFile=/etc/kb/backup.env
Environment=BACKUP_METRICS_FILE=/var/lib/node_exporter/textfile/kb_backup.prom
ExecStart=/opt/kb/scripts/backup/backup.sh --objects-only
Nice=10
IOSchedulingClass=idle
ProtectSystem=strict
ReadWritePaths=/srv/backups/kb /var/lib/node_exporter/textfile /tmp 
ReadOnlyPaths=/var/lib/kb
